<UserControl
     x:Class="TelltaleTextureTool.Views.MainView"
     xmlns="https://github.com/avaloniaui"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:paz="using:Avalonia.Controls.PanAndZoom"
     xmlns:vm="clr-namespace:TelltaleTextureTool.ViewModels"
     d:DesignHeight="1000"
     d:DesignWidth="1500"
     x:DataType="vm:MainViewModel"
     mc:Ignorable="d">
     <Design.DataContext>
          <!--
               This only sets the DataContext for the previewer in an IDE,
               to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
          -->
          <vm:MainViewModel />
     </Design.DataContext>
     <UserControl.Resources>
          <vm:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
          <vm:DimensionsConverter x:Key="DimensionsConverter" />
          <vm:BackgroundTypeToBrushConverter x:Key="BackgroundTypeToBrushConverter" />
          <vm:MaxValueDisplayConverter x:Key="MaxValueDisplayConverter" />
     </UserControl.Resources>

     <DockPanel VerticalSpacing="6">
          <Menu DockPanel.Dock="Top">
               <MenuItem Header="File">
                    <MenuItem
                         Command="{Binding OpenFileButton_Click}"
                         Header="Open File"
                         HotKey="Ctrl+O"
                         InputGesture="Ctrl+O"
                         ToolTip.Tip="Open File and its folder">
                         <MenuItem.Icon>
                              <Image
                                   Width="16"
                                   Height="16"
                                   Source="{SvgImage /Assets/open_folder_icon.svg}" />
                         </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                         Command="{Binding OpenDirectoryButton_Click}"
                         Header="Open Folder"
                         HotKey="Ctrl+F"
                         InputGesture="Ctrl+F"
                         ToolTip.Tip="Open Folder">
                         <MenuItem.Icon>
                              <Image
                                   Width="16"
                                   Height="16"
                                   Source="{SvgImage /Assets/open_folder_icon.svg}" />
                         </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                         Command="{Binding SaveFileButton_Click}"
                         Header="Save File"
                         HotKey="Ctrl+S"
                         InputGesture="Ctrl+S"
                         IsEnabled="{Binding SaveButtonStatus}"
                         ToolTip.Tip="Save File">
                         <MenuItem.Icon>
                              <Image
                                   Width="16"
                                   Height="16"
                                   Source="{SvgImage /Assets/save_icon.svg}" />
                         </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                         Command="{Binding AddFilesCommand}"
                         Header="Add Files"
                         HotKey="Ctrl+D"
                         InputGesture="Ctrl+D"
                         IsEnabled="True"
                         ToolTip.Tip="Add files to workspace">
                         <MenuItem.Icon>
                              <Image
                                   Width="16"
                                   Height="16"
                                   Source="{SvgImage /Assets/add_icon.svg}" />
                         </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                         Command="{Binding DeleteFileCommand}"
                         Header="Delete File"
                         HotKey="Delete"
                         InputGesture="Delete"
                         IsEnabled="{Binding DeleteButtonStatus}"
                         ToolTip.Tip="Delete file">
                         <MenuItem.Icon>
                              <Image
                                   Width="16"
                                   Height="16"
                                   Source="{SvgImage /Assets/delete_icon.svg}" />
                         </MenuItem.Icon>
                    </MenuItem>
               </MenuItem>
               <MenuItem Header="View">
                    <MenuItem Header="File Explorer">
                         <MenuItem
                              Header="View Name"
                              IsChecked="{Binding FileExplorerContext.ColumnSettings.IsNameVisible, Mode=TwoWay}"
                              ToggleType="CheckBox" />
                         <MenuItem
                              Header="View Type"
                              IsChecked="{Binding FileExplorerContext.ColumnSettings.IsExtensionVisible, Mode=TwoWay}"
                              ToggleType="CheckBox" />
                         <MenuItem
                              Header="View Size"
                              IsChecked="{Binding FileExplorerContext.ColumnSettings.IsSizeVisible, Mode=TwoWay}"
                              ToggleType="CheckBox" />
                         <MenuItem
                              Header="View Date Created"
                              IsChecked="{Binding FileExplorerContext.ColumnSettings.IsCreatedDateVisible, Mode=TwoWay}"
                              ToggleType="CheckBox" />
                         <MenuItem
                              Header="View Date Modified"
                              IsChecked="{Binding FileExplorerContext.ColumnSettings.IsModifiedDateVisible, Mode=TwoWay}"
                              ToggleType="CheckBox" />
                    </MenuItem>
                    <MenuItem
                         Name="ViewMipCountMenuItem"
                         Command="{Binding ToggleMipSliderVisibilityCommand}"
                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                         Header="View Mip Count"
                         IsChecked="{Binding FileExplorerContext.ColumnSettings.IsMipSliderVisible, Mode=TwoWay}"
                         ToggleType="CheckBox" />
                    <MenuItem
                         Header="View Debug Info"
                         IsChecked="{Binding IsDebugInfoVisible, Mode=TwoWay}"
                         ToggleType="CheckBox" />

               </MenuItem>
               <MenuItem Header="Help" ToolTip.Tip="Help">
                    <MenuItem
                         Command="{Binding HelpButton_ClickCommand}"
                         Header="Help"
                         HotKey="F1"
                         Icon="{SvgImage /Assets/help_icon.svg}"
                         InputGesture="F1" />
                    <MenuItem
                         Command="{Binding AboutButton_ClickCommand}"
                         Header="About"
                         Icon="{SvgImage /Assets/about_icon.svg}" />
               </MenuItem>
          </Menu>

          <Grid>
               <!--  MAIN COLUMN DEFINITIONS  -->
               <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="256" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="600" MinWidth="128" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="128" />
               </Grid.ColumnDefinitions>
               <GridSplitter
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" />
               <GridSplitter
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" />
               <!--  Background="{DynamicResource MainPanelColor}"  -->
               <Grid
                    Grid.Column="0"
                    MinWidth="250"
                    DataContext="{Binding FileExplorerContext}"
                    RowDefinitions="auto, auto, *">

                    <Grid
                         Grid.Row="0"
                         Margin="4,0,4,0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         ColumnDefinitions="*,auto,auto">
                         <TextBox
                              Name="TextureDirectoryDirectoryPathTextBox"
                              Grid.Column="0"
                              Margin="0,4,4,4"
                              HorizontalAlignment="Stretch"
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Text="{Binding CurrentDirectory}"
                              ToolTip.Tip="{Binding CurrentDirectory}"
                              Watermark="Selected Directory" />
                         <Button
                              Grid.Column="1"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0.4"
                              Command="{Binding ReturnDirectory}"
                              ToolTip.Tip="Return to parent directory">
                              <Button.Content>
                                   <Image
                                        Width="32"
                                        Height="32"
                                        Source="{SvgImage /Assets/folder_parent_icon.svg}" />
                              </Button.Content>
                         </Button>
                    </Grid>

                    <TextBox
                         Grid.Row="1"
                         Grid.Column="0"
                         Margin="4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         ToolTip.Tip="Search for a file or folder in the current directory"
                         Watermark="Search" />

                    <DataGrid
                         Name="TextureDirectoryFilesDataGrid"
                         Grid.Row="2"
                         VerticalAlignment="Stretch"
                         AutoGenerateColumns="False"
                         CanUserResizeColumns="True"
                         IsReadOnly="true"
                         ItemsSource="{Binding FilteredDirectoryFiles}"
                         SelectedItem="{Binding SelectedItem}"
                         ToolTip.Tip="Double clicking on a cell opens the file with the preferred program. Double clicking a folder opens it inside the app. Selecting a folder enables bulk conversion (From gets unlocked).">
                         <Interaction.Behaviors>
                              <EventTriggerBehavior EventName="DoubleTapped" SourceObject="TextureDirectoryFilesDataGrid">
                                   <CallMethodAction MethodName="RowDoubleTapped" TargetObject="{Binding}" />
                              </EventTriggerBehavior>
                         </Interaction.Behaviors>
                         <DataGrid.Columns>
                              <DataGridTextColumn
                                   Width="300"
                                   Binding="{Binding Name}"
                                   Header="Name"
                                   IsVisible="{Binding ColumnSettings.IsNameVisible}" />
                              <DataGridTextColumn
                                   Width="auto"
                                   Binding="{Binding Type}"
                                   Header="Type"
                                   IsVisible="{Binding ColumnSettings.IsExtensionVisible}" />
                              <DataGridTextColumn
                                   Width="auto"
                                   Binding="{Binding Size}"
                                   Header="Size"
                                   IsVisible="{Binding ColumnSettings.IsSizeVisible}" />
                              <DataGridTextColumn
                                   Width="auto"
                                   Binding="{Binding CreatedDate}"
                                   Header="Date Created"
                                   IsVisible="{Binding ColumnSettings.IsCreatedDateVisible}" />
                              <DataGridTextColumn
                                   Width="auto"
                                   Binding="{Binding ModifiedDate}"
                                   Header="Date Modified"
                                   IsVisible="{Binding ColumnSettings.IsModifiedDateVisible}" />
                         </DataGrid.Columns>
                         <DataGrid.ContextFlyout>
                              <MenuFlyout>
                                   <MenuItem
                                        Name="ContextMenuOpenFile"
                                        Command="{Binding ContextMenuOpenFileCommand}"
                                        Header="Open File" />
                                   <MenuItem
                                        Name="ContextMenuOpenFolder"
                                        Command="{Binding ContextMenuOpenFolderCommand}"
                                        Header="Open Folder"
                                        IsEnabled="{Binding ContextOpenFolderStatus}" />
                                   <MenuItem
                                        Name="ContextMenuOpenFileInFileExplorer"
                                        Command="{Binding ContextMenuOpenFileExplorerCommand}"
                                        Header="Open in Explorer" />
                                   <Separator />
                                   <MenuItem
                                        Name="ContextMenuAddFiles"
                                        Command="{Binding AddFilesCommand}"
                                        Header="Add File"
                                        Icon="{SvgImage /Assets/add_icon.svg}" />
                                   <MenuItem
                                        Name="ContextMenuDeleteFile"
                                        Command="{Binding DeleteFileCommand}"
                                        Header="Delete File"
                                        Icon="{SvgImage /Assets/delete_icon.svg}" />
                              </MenuFlyout>
                         </DataGrid.ContextFlyout>
                    </DataGrid>
               </Grid>
               <ScrollViewer Grid.Column="4">
                    <Grid VerticalAlignment="Stretch" RowDefinitions="auto,auto,auto">

                         <!--  IMAGE PREVIEW  -->
                         <!--  Image Properties  -->
                         <Expander
                              Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              BorderThickness="0"
                              Header="Image Information"
                              IsExpanded="{Binding IsImageInformationVisible}">

                              <TreeDataGrid
                                   HorizontalAlignment="Stretch"
                                   CanUserResizeColumns="False"
                                   CanUserSortColumns="False"
                                   ShowColumnHeaders="False"
                                   Source="{Binding ImagePropertiesContext.Source}" />
                         </Expander>
                         <Border
                              Grid.Row="1"
                              Margin="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              BorderBrush="Black"
                              BorderThickness="1">
                              <StackPanel Margin="4" VerticalAlignment="Stretch">

                                   <Grid ColumnDefinitions="auto,auto" RowDefinitions="auto, auto, auto, auto, auto, auto, auto, auto, auto, auto">
                                        <Label
                                             Grid.Row="0"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Game Key"
                                             ToolTip.Tip="Select the correct game to load the texture faster. Use default if it is a newer game." />
                                        <!--  IsEnabled="{Binding VersionConvertComboBoxStatus}"  -->
                                        <ComboBox
                                             Grid.Row="0"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             ItemsSource="{Binding Games}"
                                             SelectedItem="{Binding ConverterOptions.GameID, Mode=TwoWay}"
                                             ToolTip.Tip="Select the correct game to load the texture faster. Use default if it is a newer game.">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label
                                             Grid.Row="1"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Auto Compression" />
                                        <CheckBox
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             IsChecked="{Binding ConverterOptions.EnableAutomaticCompression, Mode=TwoWay}"
                                             ToolTip.Tip="Enable this option if you want to compress your textures. Works only for DXT/BC compressions." />
                                        <Label
                                             Grid.Row="2"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Auto Normal Maps" />
                                        <CheckBox
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             IsChecked="{Binding ConverterOptions.EnableTelltaleNormalMap, Mode=TwoWay}"
                                             ToolTip.Tip="When enabled, the channels are reversed for RGBA normal maps and BC5 compression is used on RG normal maps." />

                                        <Label
                                             Grid.Row="3"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Max Mip Count"
                                             ToolTip.Tip="When enabled, you can auto generate mips or select the number manually. The latter option is used for console and mobile games." />
                                        <NumericUpDown
                                             Name="MyNumericUpDown"
                                             Grid.Row="3"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             Increment="1"
                                             Maximum="{Binding MaxMipCountButton}"
                                             Minimum="1"
                                             Value="{Binding ConverterOptions.SetMips, Mode=TwoWay}">
                                             <NumericUpDown.Value>
                                                  <Binding
                                                       Converter="{StaticResource MaxValueDisplayConverter}"
                                                       Mode="TwoWay"
                                                       Path="ConverterOptions.SetMips">

                                                       <Binding.ConverterParameter>
                                                            <Binding ElementName="MyNumericUpDown" Path="Maximum" />
                                                       </Binding.ConverterParameter>
                                                  </Binding>
                                             </NumericUpDown.Value>
                                        </NumericUpDown>

                                        <Label
                                             Grid.Row="4"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Swizzling Type"
                                             ToolTip.Tip="When enabled, you can select to either swizzle or deswizzle the texture. It is used for console games." />
                                        <ComboBox
                                             Grid.Row="4"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Top"
                                             ItemsSource="{Binding SwizzlePlatforms}"
                                             SelectedItem="{Binding ConverterOptions.PlatformType, Mode=TwoWay}"
                                             ToolTip.Tip="Platforms">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label
                                             Grid.Row="5"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Deswizzling Type" />
                                        <ComboBox
                                             Grid.Row="5"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             ItemsSource="{Binding SwizzlePlatforms}"
                                             SelectedItem="{Binding ConverterOptions.PlatformType, Mode=TwoWay}"
                                             ToolTip.Tip="Platforms">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label
                                             Grid.Row="6"
                                             Grid.Column="0"
                                             Height="30"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Effect" />
                                        <ComboBox
                                             Grid.Row="6"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             ItemsSource="{Binding ImageConversionModes}"
                                             SelectedItem="{Binding ConverterOptions.ImageEffect, Mode=TwoWay}">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Label
                                             Grid.Row="7"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Input Format" />
                                        <ComboBox
                                             Grid.Row="7"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             IsEnabled="{Binding IsInputFormatComboboxEnabled}"
                                             ItemsSource="{Binding InputFormatsList}"
                                             SelectedItem="{Binding InputFormat}"
                                             ToolTip.Tip="Available image formats.">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock IsVisible="{Binding IsVisible}" Text="{Binding Name}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label
                                             Grid.Row="8"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Output Format" />
                                        <ComboBox
                                             Grid.Row="8"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             IsEnabled="{Binding IsOutputFormatComboboxEnabled}"
                                             ItemsSource="{Binding OutputFormatsList}"
                                             SelectedItem="{Binding OutputFormat}"
                                             ToolTip.Tip="Available image formats.">
                                             <ComboBox.ItemTemplate>
                                                  <DataTemplate>
                                                       <TextBlock IsVisible="{Binding IsVisible}" Text="{Binding Name}" />
                                                  </DataTemplate>
                                             </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Label
                                             Grid.Row="9"
                                             Grid.Column="0"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Content="Output Directory"
                                             ToolTip.Tip="The directory where the converted files will be saved." />
                                        <CheckBox
                                             Name="ChooseOutputDirectoryCheckBox"
                                             Grid.Row="9"
                                             Grid.Column="1"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             IsEnabled="{Binding IsChooseOutputDirectoryCheckBoxEnabled}" />
                                   </Grid>
                                   <Separator />
                                   <!--  SelectedIndex="{Binding SelectedConvertOptionsComboBoxIndex}"  -->



                                   <!--  IsChecked="{Binding ChooseOutputDirectoryCheckBoxStatus}"  -->

                                   <Grid ColumnDefinitions="*,*,*">

                                        <Button
                                             Name="ConvertButtonSingle"
                                             Grid.Column="0"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Command="{Binding ConvertButton_Click}"
                                             CommandParameter="{Binding ElementName=TextureDirectoryFilesDataGrid, Path=SelectedItems}"
                                             Content="Convert"
                                             IsEnabled="{Binding ConvertButtonStatus}"
                                             ToolTip.Tip="Convert the file into the desired format." />
                                        <Button
                                             Name="ConvertButtonBatch"
                                             Grid.Column="1"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Command="{Binding ConvertButton_Click}"
                                             CommandParameter="{Binding ElementName=TextureDirectoryFilesDataGrid, Path=SelectedItems}"
                                             Content="Convert All"
                                             IsEnabled="{Binding ConvertButtonStatus}"
                                             ToolTip.Tip="Convert the file into the desired format." />
                                        <Button
                                             Name="ConvertButtonBatchFilter"
                                             Grid.Column="2"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Command="{Binding ConvertButton_Click}"
                                             CommandParameter="{Binding ElementName=TextureDirectoryFilesDataGrid, Path=SelectedItems}"
                                             Content="Convert Filtered"
                                             IsEnabled="{Binding ConvertButtonStatus}"
                                             ToolTip.Tip="Convert the file into the desired format." />
                                   </Grid>
                              </StackPanel>
                         </Border>

                         <Expander
                              Grid.Row="2"
                              HorizontalAlignment="Stretch"
                              BorderThickness="0"
                              Header="Debug Information"
                              IsVisible="{Binding IsDebugInfoVisible}">
                              <Expander.Header />
                              <TextBox
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsReadOnly="True"
                                   Text="{Binding DebugInfo}"
                                   TextWrapping="Wrap" />
                         </Expander>

                    </Grid>
               </ScrollViewer>
               <Grid Grid.Column="2">
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                         <!--  Ensure the Grid can expand  -->
                         <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <!--  For the Label  -->
                              <RowDefinition Height="*" />
                              <!--  For the ScrollViewer and ZoomBorder  -->
                         </Grid.RowDefinitions>
                         <WrapPanel
                              Grid.Row="0"
                              Margin="4,0,4,0"
                              VerticalAlignment="Stretch"
                              Orientation="Horizontal">

                              <Grid
                                   MinWidth="150"
                                   Margin="0,4,4,4"
                                   IsVisible="{Binding IsMipSliderVisible}">

                                   <Slider
                                        x:Name="MipSlider"
                                        Height="32"
                                        MinWidth="100"
                                        MaxWidth="150"
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        IsSnapToTickEnabled="True"
                                        Maximum="{Binding MaxMipCount}"
                                        Minimum="0"
                                        TickFrequency="1.0"
                                        Value="{Binding MipValue}" />
                                   <Label
                                        Height="32"
                                        MaxWidth="180"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Content="{Binding MipValue, StringFormat='Mip: {0}'}"
                                        IsHitTestVisible="False" />

                              </Grid>

                              <Grid
                                   MinWidth="150"
                                   Margin="4,0,4,4"
                                   IsVisible="{Binding IsFaceSliderVisible}">
                                   <Slider
                                        x:Name="FaceSlider"
                                        Height="32"
                                        MaxWidth="150"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        IsSnapToTickEnabled="True"
                                        Maximum="{Binding MaxFaceCount}"
                                        Minimum="0"
                                        TickFrequency="1"
                                        Value="{Binding FaceValue}" />
                                   <Label
                                        MaxWidth="180"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{Binding FaceValue, StringFormat='Face: {0}'}"
                                        IsHitTestVisible="False" />
                              </Grid>
                              <!--  IsVisible="{Binding IsSliceSliderVisible}"  -->

                              <Grid
                                   MinWidth="150"
                                   Margin="4,0,0,4"
                                   IsVisible="{Binding IsSliceSliderVisible}">
                                   <Slider
                                        x:Name="SliceSlider"
                                        MaxWidth="150"
                                        IsSnapToTickEnabled="True"
                                        Maximum="{Binding MaxSliceCount}"
                                        Minimum="0"
                                        TickFrequency="1"
                                        Value="{Binding SliceValue}" />
                                   <Label
                                        MaxWidth="180"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{Binding SliceValue, StringFormat='Slice: {0}'}"
                                        IsHitTestVisible="False" />
                              </Grid>

                         </WrapPanel>

                         <ScrollViewer
                              Grid.Row="1"
                              Margin="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">

                              <paz:ZoomBorder
                                   Name="ZoomBorder1"
                                   MinWidth="128"
                                   MinHeight="128"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ClipToBounds="True"
                                   EnableConstrains="False"
                                   EnablePan="{Binding HasImage}"
                                   EnableZoom="{Binding HasImage}"
                                   Focusable="True"
                                   PanButton="Left"
                                   ZoomSpeed="1.5">
                                   <!--  Image Preview (Don't change)  -->

                                   <Border
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        BorderThickness="1">

                                        <Border.Transitions>
                                             <Transitions>
                                                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                                             </Transitions>
                                        </Border.Transitions>



                                        <!--  Set Stretch to Fill to ignore aspect ratio  -->
                                        <Grid>
                                             <Viewbox
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform">
                                                  <Grid>
                                                       <!--  Checkerboard background (matches image size)  -->
                                                       <Border Background="{Binding ImageBackground, Converter={StaticResource BackgroundTypeToBrushConverter}}" IsVisible="{Binding HasImage}">
                                                            <!--  This ensures the checkerboard tiles match the image's pixel dimensions  -->
                                                            <Rectangle Width="{Binding #PreviewImage.Bounds.Width}" Height="{Binding #PreviewImage.Bounds.Height}" />
                                                       </Border>

                                                       <!--  The actual image  -->
                                                       <Image
                                                            x:Name="PreviewImage"
                                                            IsVisible="{Binding HasImage}"
                                                            RenderOptions.BitmapInterpolationMode="None"
                                                            Source="{Binding ImagePreview}"
                                                            Stretch="None" />
                                                       <!--  Important: Stretch=None here  -->
                                                  </Grid>
                                             </Viewbox>
                                             <!-- <Border
                                                  Background="{Binding ImageBackground, Converter={StaticResource BackgroundTypeToBrushConverter}}"
                                                  IsVisible="{Binding HasImage}"
                                                  ZIndex="-1">
                                                  <Image
                                                       x:Name="PreviewImage"
                                                       IsVisible="{Binding HasImage}"
                                                       RenderOptions.BitmapInterpolationMode="None"
                                                       Source="{Binding ImagePreview}"
                                                       Stretch="Uniform" />

                                             </Border>-->


                                             <!--  Placeholder (visible when no image)  -->
                                             <Border IsVisible="{Binding !HasImage}">
                                                  <TextBlock
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontStyle="Italic"
                                                       Foreground="Gray"
                                                       Text="No image available" />
                                             </Border>


                                        </Grid>


                                   </Border>
                              </paz:ZoomBorder>
                         </ScrollViewer>
                    </Grid>
               </Grid>
          </Grid>
     </DockPanel>
</UserControl>
